{
  "name": "@qnx/message",
  "description": "Collection of utilities of message",
  "author": "Yatendra Kushwaha <https://github.com/yatendra121>",
  "version": "0.8.17",
  "license": "MIT",
  "funding": "https://github.com/sponsors/yatendra121",
  "files": [
    "dist"
  ],
  "keywords": [
    "response message"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yatendra121/qnx.git"
  },
  "main": "./dist/message.cjs",
  "module": "./dist/message.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/message.cjs",
      "import": "./dist/message.mjs"
    }
  },
  "unpkg": "./dist/message.iife.js",
  "jsdelivr": "./dist/message.iife.js",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.lib.json --noEmit && vite build && dts-bundle-generator --config ./dts-bundle-generator.config.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:scripts": "eslint . --ext .ts",
    "format:scripts": "prettier . --write",
    "format": "npm run format:scripts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
