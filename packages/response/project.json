{
  "name": "response",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/response/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/response/dist"],
      "options": {
        "commands": [
          {
            "command": "npm run build",
            "forwardAllArgs": true
          }
        ],
        "cwd": "packages/response",
        "outputPath": "packages/response/dist"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/scripts/publish.ts response "
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/packages/response"],
      "options": {
        "command": "vitest run",
        "cwd": "packages/response",
        "passWithNoTests": false,
        "coverage.reportsDirectory": "../../coverage/packages/response"
      }
    },
    "vitest": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "pnpm test",
            "forwardAllArgs": true
          }
        ],
        "cwd": "packages/response"
      }
    }
  }
}
