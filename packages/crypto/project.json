{
  "name": "crypto",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/crypto/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/crypto/dist"
      ],
      "options": {
        "commands": [
          {
            "command": "npm run build",
            "forwardAllArgs": true
          }
        ],
        "cwd": "packages/crypto",
        "outputPath": "{workspaceRoot}/packages/crypto/dist"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/scripts/publish.ts crypto "
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx tools/scripts/clean.ts crypto "
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/packages/crypto"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "packages/crypto",
        "passWithNoTests": false,
        "coverage.reportsDirectory": "../../coverage/packages/crypto"
      }
    },
    "test2": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "pnpm test",
            "forwardAllArgs": true
          }
        ],
        "cwd": "packages/crypto"
      }
    }
  }
}
