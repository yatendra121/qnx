{
  "name": "winston",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/winston/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/winston/dist"],
      "options": {
        "commands": [
          {
            "command": "npm run build",
            "forwardAllArgs": true
          }
        ],
        "cwd": "packages/winston",
        "outputPath": "packages/winston/dist"
      }
    },
    "build-nx": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/{options.outDir}", "{projectRoot}/dist"],
      "options": {
        "outDir": "../../dist/packages/winston"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/scripts/publish.ts winston "
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/packages/winston"],
      "options": {
        "command": "vitest run",
        "cwd": "packages/winston",
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../coverage/packages/winston"
      }
    }
  }
}
