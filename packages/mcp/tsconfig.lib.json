{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@qnx/crypto": ["../crypto/src/index.ts"],
      "@qnx/errors": ["../errors/src/index.ts"],
      "@qnx/response": ["../response/src/index.ts"],
      "@qnx/winston": ["../winston/src/index.ts"]
    },
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "bundler",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"],
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "skipLibCheck": false,
    "skipDefaultLibCheck": false
  },
  "include": ["**/*.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.ts",
    "node_modules",
    "test/**",
    ".history/**",
    "jest.config.ts",
    "vite.config.ts",
    "**/*.spec.ts"
  ]
}
