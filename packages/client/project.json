{
  "name": "client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/client/dist"],
      "options": {
        "commands": [
          {
            "command": "npm run build",
            "forwardAllArgs": true
          }
        ],
        "cwd": "packages/client",
        "outputPath": "packages/client/dist"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/scripts/publish.ts client "
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/packages/client"],
      "options": {
        "command": "vitest run",
        "cwd": "packages/client",
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../coverage/packages/client"
      }
    },
    "vitest": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "pnpm test",
            "forwardAllArgs": true
          }
        ],
        "cwd": "packages/client"
      }
    }
  }
}
