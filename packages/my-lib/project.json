{
  "name": "my-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/my-lib/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{projectRoot}/dist"],
      "options": {
        "outDir": "../../dist/packages/my-lib"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../coverage/packages/my-lib"
      }
    }
  }
}
